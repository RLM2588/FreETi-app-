<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainScreen">

    <ImageButton
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/outline_account_child_invert_24"


        android:id="@+id/main_settings"

        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="17dp"
        />

    <ImageButton
        android:id="@+id/main_refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="@+id/main_settings"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/main_settings"
        app:layout_constraintTop_toBottomOf="@+id/main_settings"
        app:srcCompat="@drawable/ic_refresh1"
        app:tint="@color/for_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="март 2007"
        android:textSize="30sp"
        android:id="@+id/main_month"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/main_settings"
        app:layout_constraintBottom_toTopOf="@+id/main_tasks_without_time"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="5dp"
        android:textStyle="bold"
        android:textColor="@color/for_text"/>
    <ImageButton
        android:id="@+id/main_next_day"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/main_month"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/main_month"
        app:srcCompat="@drawable/ic_pastday"
        app:tint="@color/for_text" />


    <ImageButton
        android:id="@+id/main_prev_day"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="15dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/main_next_day"
        app:layout_constraintEnd_toStartOf="@id/main_next_day"
        app:layout_constraintTop_toTopOf="@id/main_next_day"
        app:srcCompat="@drawable/ic_nextday"
        app:tint="@color/for_text" />


    <TextView

        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="17"
        android:textSize="30sp"
        android:id="@+id/main_date"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/main_settings"
        app:layout_constraintTop_toBottomOf="@id/main_settings"
        android:layout_marginStart="5dp"

        android:layout_marginTop="55dp"
        android:textColor="@color/for_text"/>

    <TextView
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="Пн"
        android:textSize="30sp"
        android:id="@+id/main_day_week"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/main_settings"
        app:layout_constraintTop_toBottomOf="@id/main_date"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/for_text"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_tasks_without_time"
        android:layout_height="0dp"
        android:layout_width="0dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="41dp"
        app:layout_constraintTop_toBottomOf="@id/main_settings"
        app:layout_constraintBottom_toBottomOf="@id/main_day_week"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/main_settings"
        tools:listitem="@layout/item_task_no_time"/>

    <ScrollView
        android:id="@+id/main_tasks2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_tasks_without_time"
        app:layout_constraintVertical_bias="0.0"
        android:layout_marginTop="20dp">

        <HorizontalScrollView
            android:id="@+id/timeline_horizontal_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <com.example.freeti.views.TaskTimelineView
                android:id="@+id/main_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </ScrollView>

    <Button
        android:id="@+id/main_unassigned_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="8dp"
        android:text="Список"
        android:textColor="@color/bg"
        android:backgroundTint="@color/for_text"
        app:layout_constraintEnd_toStartOf="@+id/main_new_task"
        app:layout_constraintTop_toTopOf="@id/main_new_task"
        app:tint="@color/for_text" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/main_new_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="30dp"
        app:srcCompat="@drawable/ic_add_tru"
        app:backgroundTint="@color/for_text"
        app:tint="@color/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="30dp"
        app:cardBackgroundColor="@color/bg"

        />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/main_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="30dp"
        app:fabSize="normal"

        app:backgroundTint="@color/for_text"
        app:tint="@color/bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_tasks2" />

</androidx.constraintlayout.widget.ConstraintLayout>