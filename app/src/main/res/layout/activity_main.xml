<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="..."
        android:textSize="30dp"
        android:id="@id/main_settings"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="5dp"
        android:background="#ABABAB"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17"
        android:textSize="20dp"
        android:id="@+id/main_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_settings"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        android:background="#ABABAB"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вт"
        android:textSize="20dp"
        android:id="@+id/main_day_week"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_date"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:background="#ABABAB"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_tasks_without_time"
        android:layout_height="689dp"
        android:layout_width="0dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="41dp"
        app:layout_constraintTop_toBottomOf="@id/main_settings"
        app:layout_constraintHeight="100dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/main_settings"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_tasks_without_time"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>