<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_panel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/task_esc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:importantForAccessibility="no"
            app:fabSize="mini"
            app:srcCompat="@drawable/outline_arrow_back_24"
            app:backgroundTint="@color/bg"
            app:tint="@color/for_text"
            android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/task_title_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Новая задача"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/for_text"
            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintStart_toEndOf="@+id/task_esc"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_panel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Название"
                android:textColor="@color/for_text"
                android:textColorHint="@color/for_text"
                android:layout_marginTop="10dp"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/task_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Описание"
                android:textColor="@color/for_text"
                android:textColorHint="@color/for_text"
                android:layout_marginTop="10dp" />
            <LinearLayout
                android:id="@+id/task_layout_importance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приоретет:"
                    android:textSize="18sp"
                    android:textColor="@color/for_text"/>
                <Spinner
                    android:id="@+id/task_importance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textSize="20sp"
                    android:backgroundTint="@color/for_text" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/task_layout_no_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <CheckBox
                    android:id="@+id/task_no_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Без времени"
                    android:textSize="20sp"
                    android:textColor="@color/for_text"
                    android:buttonTint="@color/for_text"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/task_privacy"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    app:cornerRadius="8dp"/>

            </LinearLayout>

            <CheckBox
                android:id="@+id/task_without_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Не распределенная"
                android:textSize="20sp"
                android:textColor="@color/for_text"
                android:buttonTint="@color/for_text"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg"
                android:layout_marginTop="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/for_text">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/task_times"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/task_layout_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Начало:"
                            android:textSize="18sp"
                            android:textColor="@color/for_text"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/task_date_start"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/for_text"
                            android:text="Дата" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/task_time_start"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/for_text"
                            android:text="Время" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/task_layout_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33888888"
                            android:layout_marginVertical="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Конец:"
                                android:textSize="18sp"
                                android:textColor="@color/for_text"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/task_date_end"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/for_text"
                                android:text="Дата" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/task_time_end"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/for_text"
                                android:text="Время" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Button
                android:id="@+id/task_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newtask_plusday"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/for_text"
                android:buttonTint="@color/for_text"
                android:textColor="@color/bg"/>




            <LinearLayout
                android:id="@+id/task_layout_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Цвет (#):"
                    android:textSize="20sp"
                    android:textColor="@color/for_text"/>

                <EditText
                    android:id="@+id/task_et_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLength="6"
                    android:inputType="text" />
                <View
                    android:id="@+id/task_view_color_preview"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/darker_gray"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#FFFFFF"
                    android:layout_marginStart="12dp"
                    android:id="@+id/white_color"/>

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#BB3344"
                    android:layout_marginStart="12dp"
                    android:id="@+id/red_color"/>

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#22AA55"
                    android:layout_marginStart="12dp"
                    android:id="@+id/green_color"/>

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#3355AB"
                    android:layout_marginStart="12dp"
                    android:id="@+id/blue_color"/>

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#33AAAA"
                    android:layout_marginStart="12dp"
                    android:id="@+id/grbl_color"/>

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#888888"
                    android:layout_marginStart="12dp"
                    android:id="@+id/gray_color"/>

            </LinearLayout>

            <CheckBox
                android:id="@+id/task_is_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Состояние задачи"
                android:buttonTint="@color/for_text"
                android:textSize="20sp"
                android:textColor="@color/for_text" />


            <LinearLayout
                android:id="@+id/task_layout_ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp">

                <Button
                    android:id="@+id/task_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сохранить"
                    android:textSize="16sp"
                    android:layout_marginTop="0dp"
                    android:backgroundTint="#88AA99"
                    android:textColor="#000000"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/task_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:backgroundTint="#88CC99"
                    android:text="Сохранить и выйти"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </LinearLayout>




            <Button
                android:id="@+id/task_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Удалить"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>