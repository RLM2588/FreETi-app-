<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"

        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageViewTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="1000dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/up_2_log" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:fontFamily="@font/montserrat_extrabold"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textColor="@color/for_text"
            android:textSize="68sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/greetings_1"
            android:textColor="@color/for_text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="5dp"
                android:paddingHorizontal="0dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/user_icon1"
                    app:tint="@color/for_text" />


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:layout_marginLeft="5dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="@color/bg"
                    app:boxStrokeColor="#FF909faf"



                    app:boxStrokeWidth="3dp">


                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/log_in_user_name"
                        android:textColor="@color/for_text"  android:textColorHint="@color/for_hint"
                        android:textSize="18sp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart ="0dp"
                        android:paddingBottom="0dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="5dp"
                android:paddingHorizontal="0dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/lock_icon1"
                    app:tint="@color/for_text" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_marginLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    app:hintEnabled="false"
                    app:passwordToggleTint="#FF909faf"
                    app:boxBackgroundColor="@color/bg"
                    app:boxStrokeColor="@color/for_text"
                    app:boxStrokeWidth="3dp"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF909faf"  android:textColorHint="#90909faf"
                        android:hint="@string/log_in_password"
                        android:inputType="textPassword"
                        android:textSize="18sp"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingBottom="0dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/log_in_button_1"
                android:textColor="@color/bg"
                android:textSize="18sp"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/for_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_acc"
                android:textColor="@color/for_text"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/log_in_button_2"
                android:textColor="@color/bg"
                android:textSize="18sp"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/for_text" />

        </LinearLayout>
    </LinearLayout>



    <ImageView
        android:id="@+id/imageViewBottom"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="-10dp"
        app:srcCompat="@drawable/down_img_1" />

</androidx.constraintlayout.widget.ConstraintLayout>